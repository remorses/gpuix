{
  "$schema": "https://holocron.so/docs.json",
  "name": "GPUIX",
  "description": "GPUI and React for native apps. GPUIX paints a React tree with GPUI, Zed's GPU UI framework.",
  "colors": {
    "primary": "#234e9d"
  },
  "appearance": {
    "default": "system"
  },
  "layout": {
    "mode": "compact"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/remorses/gpuix"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "lucide:book-open",
        "groups": [
          {
            "group": "Overview",
            "icon": "lucide:home",
            "pages": ["index"]
          },
          {
            "group": "Guides",
            "icon": "lucide:map",
            "pages": ["guides/solid", "guides/ilha", "guides/hermes"]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "lucide:newspaper",
        "changelog": "https://github.com/remorses/gpuix",
        "initialContent": "changelog/intro"
      },
      {
        "tab": "GitHub",
        "icon": "lucide:github",
        "href": "https://github.com/remorses/gpuix"
      },
      {
        "tab": "npm",
        "icon": "lucide:package",
        "href": "https://www.npmjs.com/package/@gpuix/react"
      }
    ]
  },
  "decorativeLines": "none"
}

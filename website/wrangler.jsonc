{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpuix-website",
  "main": "./src/server.tsx",
  "compatibility_date": "2026-03-15",
  "compatibility_flags": ["nodejs_compat"],
  // Lets the Worker read the prerendered `rendering: static` pages.
  "assets": { "binding": "ASSETS" },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "gpuix.dev"
    },
    {
      "custom_domain": true,
      "pattern": "www.gpuix.dev"
    }
  ],
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@gpuix/ilha",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "noEmit": true
  },
  "include": ["./*.tsx", "./*.ts"]
}

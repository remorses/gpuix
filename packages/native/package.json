{
  "name": "@gpuix/native",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "browser": "browser.mjs",
  "napi": {
    "binaryName": "gpuix-native",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/remorses/gpuix"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --features test-support",
    "build:release": "napi build --platform --release --no-default-features",
    "build:debug": "napi build --platform --features test-support",
    "build:browser": "bun scripts/build-browser.ts",
    "build:web": "bun ../../scripts/web.ts --build-only",
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @gpuix/native locally. CI builds all platform binaries. See AGENTS.md.'); process.exit(1) }\" && bun run build:web && napi pre-publish -t npm --no-gh-release",
    "universal": "napi universal",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.1.3"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "browser.mjs",
    "wasm",
    "cef",
    "LICENSE"
  ]
}
